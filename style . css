
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: white;
    background: #f4f8f3;
}

.cabecalho {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 25px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    z-index: 10;
}

.logo {
    font-size: 30px;
    font-weight: bold;
    text-decoration: none;
    color: white;
}

.logo span {
    color: #8be28b;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
}

nav a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

nav a:hover,
nav a[aria-current="page"] {
    color: #8be28b;
}

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 130px 7% 70px;

    background:
        linear-gradient(
            90deg,
            rgba(4, 25, 17, 0.92),
            rgba(4, 25, 17, 0.40)
        ),
        url("https://images.unsplash.com/photo-1618477461853-cf6ed80faba5?auto=format&fit=crop&w=2000&q=85")
        center/cover no-repeat;
}

.conteudo {
    max-width: 720px;
}

.subtitulo {
    color: #8be28b;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

h1 {
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.1;
    margin-bottom: 25px;
}

h1 span {
    color: #8be28b;
}

.descricao {
    max-width: 600px;
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 30px;
    color: #e0e9e2;
}

.botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.botao {
    display: inline-block;
    background: #399b58;
    color: white;
    text-decoration: none;
    padding: 15px 25px;
    border-radius: 7px;
    font-weight: bold;
    transition: 0.3s;
}

.botao:hover {
    background: #287942;
    transform: translateY(-3px);
}

.botao.secundario {
    background: transparent;
    border: 2px solid white;
}

.botao.secundario:hover {
    background: white;
    color: #174d2b;
}

footer {
    background: #102d20;
    padding: 20px;
    text-align: center;
    color: #d7e6d9;
}

.pagina {
    min-height: 75vh;
    padding: 60px 7%;
    color: #183d29;
}

.pagina h1 {
    font-size: 42px;
}

.pagina h2 {
    margin: 25px 0 12px;
}

.pagina p {
    line-height: 1.8;
    margin-bottom: 15px;
}

.formulario {
    max-width: 600px;
    display: grid;
    gap: 15px;
    margin-top: 25px;
}

.formulario input,
.formulario textarea,
.formulario select {
    width: 100%;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font: inherit;
}

.formulario textarea {
    min-height: 130px;
    resize: vertical;
}

.formulario button {
    border: none;
    cursor: pointer;
    font: inherit;
}

.cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.cartao {
    padding: 25px;
    border-radius: 10px;
    background: #e6f2e7;
}

.cartao h2 {
    margin-top: 0;
}

@media (max-width: 760px) {
    .cabecalho {
        position: relative;
        flex-direction: column;
        background: #102d20;
        padding: 20px;
    }

    nav {
        justify-content: center;
        gap: 15px;
    }

    .hero {
        min-height: 85vh;
        padding: 65px 6%;
    }

    .descricao {
        font-size: 16px;
    }

    .pagina {
        padding: 40px 6%;
    }
}
